---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { projects } from '../data/projects';
import { job, skills, education } from '../data/profile';
---
<Layout>
  <Hero />

  <section id="experience" class="pt-8 sm:pt-12 scroll-mt-24">
    <SectionHeader title="Experience" />
    <div class="grid gap-8 lg:grid-cols-[16rem_1fr] rounded-lg border border-bg-3 bg-bg-1/70 p-6 sm:p-8">
      <div>
        <p class="font-mono text-sm text-warm">{job.period}</p>
        <h3 class="mt-2 text-xl font-semibold text-ink-0">{job.role}</h3>
        <p class="text-ink-1">{job.org}</p>
        <p class="mt-2 text-sm text-ink-3">{job.note}</p>
      </div>
      <ul class="space-y-3.5">
        {job.achievements.map((a) => (
          <li class="relative pl-6 text-ink-1 leading-relaxed">
            <span class="absolute left-0 top-[0.7em] h-1.5 w-1.5 rounded-full bg-warm/80"></span>
            {a}
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-4 grid gap-8 lg:grid-cols-[16rem_1fr] rounded-lg border border-bg-3 bg-bg-1/40 px-6 py-5 sm:px-8">
      <p class="font-mono text-sm text-ink-3">{education.period}</p>
      <p class="text-ink-1"><span class="text-ink-0">{education.org}</span> · {education.degree}</p>
    </div>
  </section>

  <section id="skills" class="pt-20 sm:pt-28 scroll-mt-24">
    <SectionHeader title="Skills" />
    <dl class="grid gap-px overflow-hidden rounded-lg border border-bg-3 bg-bg-3 sm:grid-cols-2 lg:grid-cols-4">
      {skills.map((s) => (
        <div class="bg-bg-1/90 p-6">
          <dt class="font-mono text-hud uppercase text-warm">{s.area}</dt>
          <dd class="mt-3 text-ink-1 leading-relaxed">{s.items}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="projects" class="pt-20 sm:pt-28 scroll-mt-24">
    <SectionHeader title="Personal projects" />
    <div class="grid gap-5 sm:gap-6 md:grid-cols-2">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section id="contact" class="pt-20 sm:pt-28 pb-4 scroll-mt-24">
    <SectionHeader title="Contact" />
    <p class="-mt-4 mb-8 text-lg text-ink-2">Email or Telegram is the fastest way to reach me.</p>
    <ContactLinks layout="grid" class="lg:grid-cols-4" />
  </section>
</Layout>
