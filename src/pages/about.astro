---
import Layout from '../layouts/Layout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { summary, wants, doesNotWant } from '../data/profile';
---
<Layout title="About — Illia Nanarov">
  <section class="pt-20 sm:pt-28 max-w-3xl">
    <h1 class="text-5xl sm:text-6xl font-semibold text-ink-0 tracking-[-0.025em] leading-[1.02]">
      About
    </h1>

    <div class="mt-10 space-y-5 text-lg text-ink-1 leading-[1.7]">
      <p>I'm Illia, a DevOps engineer from Kyiv, Ukraine.</p>
      <p>{summary}</p>
      <p>
        Day to day: servers with Terraform, deployments with Docker Compose and GitHub Actions,
        Kubernetes with ArgoCD, moving apps between cloud providers, database migrations, and
        keeping cloud costs down.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-bg-3 bg-bg-1/70 p-6">
        <h2 class="font-mono text-hud uppercase text-warm">What I'm looking for</h2>
        <ul class="mt-4 space-y-2.5 text-ink-1">
          {wants.map((w) => <li class="relative pl-5"><span class="absolute left-0 text-signal-go">+</span>{w}</li>)}
        </ul>
      </div>
      <div class="rounded-lg border border-bg-3 bg-bg-1/70 p-6">
        <h2 class="font-mono text-hud uppercase text-warm">Not a fit</h2>
        <ul class="mt-4 space-y-2.5 text-ink-1">
          {doesNotWant.map((w) => <li class="relative pl-5"><span class="absolute left-0 text-signal-err">−</span>{w}</li>)}
        </ul>
      </div>
    </div>

    <p class="mt-6 text-ink-1">Happy to hear from DefTech / MilTech companies.</p>

    <div class="mt-16">
      <h2 class="text-2xl sm:text-3xl font-semibold text-ink-0 tracking-tight mb-6">Contact</h2>
      <ContactLinks layout="grid" />
    </div>
  </section>
</Layout>
