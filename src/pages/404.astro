---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Not found">
  <section class="pt-32 min-h-[50vh]">
    <h1 class="text-6xl sm:text-7xl font-semibold tracking-[-0.025em]">404</h1>
    <p class="mt-6 text-lg text-ink-1">Nothing at this address.</p>
    <a href={import.meta.env.BASE_URL} class="mt-8 inline-block text-ink-0 hover:text-accent transition-colors underline underline-offset-4 decoration-bg-3 hover:decoration-accent">
      ← Back to home
    </a>
  </section>
</Layout>
