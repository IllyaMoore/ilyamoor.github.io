---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  { href: `${base}#experience`, label: 'Experience', active: false },
  { href: `${base}#projects`,   label: 'Projects',   active: false },
  { href: `${base}about/`,   label: 'About',   active: path.startsWith(`${base}about`) },
  { href: `${base}#contact`, label: 'Contact', active: false },
];
const icons = [
  {
    label: 'GitHub',
    href: 'https://github.com/IllyaMoore',
    d: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/illia-nanarov-3b233b441/',
    d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
  },
  {
    label: 'Telegram',
    href: 'https://t.me/illiamoore',
    d: 'M9.78 15.27 9.4 20.6c.54 0 .78-.23 1.06-.51l2.55-2.44 5.28 3.87c.97.53 1.65.25 1.91-.89l3.46-16.24c.31-1.43-.51-1.99-1.45-1.64L1.3 10.6c-1.39.54-1.37 1.32-.24 1.67l5.19 1.62L18.3 6.3c.57-.37 1.08-.17.66.21L9.78 15.27Z',
  },
];
---
<header class="sticky top-0 z-30 border-b border-bg-3/60 bg-bg-0/75 backdrop-blur-md">
  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-14">
    <div class="mx-auto max-w-[1440px] flex items-center justify-between gap-6 h-16">
      <a href={base} class="group flex items-center gap-3">
        <span class="grid h-8 w-8 place-items-center rounded-md border border-warm/40 bg-warm/10 font-mono text-xs font-semibold text-warm group-hover:bg-warm group-hover:text-bg-0 transition-colors">
          IN
        </span>
        <span class="leading-tight">
          <span class="block text-sm font-medium text-ink-0">Illia Nanarov</span>
          <span class="hidden sm:block font-mono text-[0.6875rem] text-ink-3">DevOps engineer</span>
        </span>
      </a>

      <div class="flex items-center gap-4 sm:gap-6">
        <nav class="flex items-center gap-1 text-sm">
          {links.map((l) => (
            <a
              href={l.href}
              class:list={[
                'rounded-md px-2.5 py-1.5 transition-colors',
                l.active ? 'text-ink-0 bg-bg-2' : 'text-ink-2 hover:text-ink-0 hover:bg-bg-2/70',
              ]}
            >{l.label}</a>
          ))}
        </nav>

        <span class="hidden sm:block h-5 w-px bg-bg-3"></span>

        <ul class="hidden sm:flex items-center gap-1">
          {icons.map((i) => (
            <li>
              <a
                href={i.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={i.label}
                title={i.label}
                class="grid h-8 w-8 place-items-center rounded-md text-ink-2 hover:text-warm hover:bg-bg-2/70 transition-colors"
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={i.d} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>
