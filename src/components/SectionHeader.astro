---
interface Props {
  title: string;
  subtitle?: string;
  index?: string;
  id?: string;
}
const { title, subtitle, index, id } = Astro.props;
---
<div id={id} class="mb-10 sm:mb-12 flex flex-col gap-3">
  {index && (
    <span class="font-mono text-hud uppercase text-warm">{index} /</span>
  )}
  <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-ink-0 tracking-[-0.02em] leading-[1.05]">
    {title}
  </h2>
  {subtitle && (
    <p class="text-ink-2 text-base sm:text-lg max-w-2xl leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
