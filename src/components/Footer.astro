---
import FlagUA from './FlagUA.astro';
import { contacts } from '../data/contacts';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-bg-3/50">
  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-14">
    <div class="mx-auto max-w-[1440px] py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-mono text-ink-3">
      <span class="flex items-center gap-2">
        © {year} · Illia Nanarov · Kyiv, Ukraine
        <FlagUA size="xs" />
      </span>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {contacts.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
              class="hover:text-warm transition-colors"
            >{c.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
