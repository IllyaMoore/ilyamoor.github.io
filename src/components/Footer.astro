---
import FlagUA from './FlagUA.astro';
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-bg-3/50">
  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-14">
    <div class="mx-auto max-w-[1440px] py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono text-ink-3">
      <span class="flex items-center gap-2">
        © {year} · Illia Nanarov · Kyiv · Mykolaiv
        <FlagUA size="xs" />
      </span>
      <span>Astro · Tailwind · GitHub Pages</span>
    </div>
  </div>
</footer>
